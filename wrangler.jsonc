{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jc-futbol-coach",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["python_workers"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ]
}
