{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jc-futbol-coach",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "python_workers"
  ],
  "keep_vars": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8e39836a808241ab91d43b753b30025f"
    }
  ],
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "**/__pycache__"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
